DATABASE_URL=XxXxX

# Mirror sac-backend bypass auth for local development
BYPASS_AUTH=true
BYPASS_AUTH_SECRET=XxXx

# Keycloak (used in production when BYPASS_AUTH=false)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=dev
KEYCLOAK_CLIENT_ID=sac-mate

# Origins allowed to embed this app as an iframe
ALLOWED_FRAME_ORIGINS=http://localhost:3000
PORT=3002

SAC_BACKEND_URL=http://localhost:3005/api/v1

# Email notifications
# Set to true when SMTP is configured for the environment.
EMAIL_NOTIFICATIONS_ENABLED=false

# Public/base URL used in email links.
APP_BASE_URL=http://localhost:3002

# Local Mailpit example:
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_FROM="SAC Vacaciones <no-reply@sac.local>"

# Real SMTP example:
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@example.com
SMTP_PASS=replace-me
SMTP_FROM="SAC Vacaciones <notifications@example.com>"