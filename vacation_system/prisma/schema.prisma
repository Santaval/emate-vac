generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model usuario {
  id                          Int             @id @default(autoincrement())
  id_profesor                 Int?
  username                    String          @unique @db.VarChar(50)
  email                       String?         @unique @db.VarChar(250)
  nombre                      String          @db.VarChar(100)
  activo                      Boolean         @default(true)
  dias_vacaciones_disponibles Int             @default(0) @db.SmallInt
  usuario_rol                 usuario_rol[]
  vac_revision                vac_revision[]
  vac_solicitud               vac_solicitud[]
}

model usuario_rol {
  id_usuario Int
  rol        vac_rol_enum
  usuario    usuario      @relation(fields: [id_usuario], references: [id], onDelete: Cascade)

  @@id([id_usuario, rol])
}

model vac_solicitud {
  id                 Int             @id @default(autoincrement())
  id_usuario         Int
  fecha_inicio       DateTime        @db.Date
  fecha_fin          DateTime        @db.Date
  dias_habiles       Int             @db.SmallInt
  observacion        String?         @db.VarChar(300)
  estado             vac_estado_enum @default(Borrador)
  paso_actual        Int?            @db.SmallInt
  fecha_creacion     DateTime        @default(now()) @db.Timestamp(6)
  fecha_modificacion DateTime        @default(now()) @db.Timestamp(6)
  vac_revision       vac_revision[]
  usuario            usuario         @relation(fields: [id_usuario], references: [id])
}

model vac_revision {
  id             Int             @id @default(autoincrement())
  id_solicitud   Int
  id_usuario     Int
  rol_revisor    vac_rol_enum
  accion         vac_accion_enum
  comentario     String?         @db.VarChar(500)
  fecha_revision DateTime        @default(now()) @db.Timestamp(6)
  vac_solicitud  vac_solicitud   @relation(fields: [id_solicitud], references: [id])
  usuario        usuario         @relation(fields: [id_usuario], references: [id])
}

enum vac_rol_enum {
  Profesor
  Jefe_de_Departamento @map("Jefe de Departamento")
  Jefe_Administrativo  @map("Jefe Administrativo")
  Director_de_Escuela  @map("Director de Escuela")
}

enum vac_estado_enum {
  Borrador
  Enviado
  Aprobado
  Rechazado
}

enum vac_accion_enum {
  Aprobado
  Rechazado
  Creado
  Enviado
  Editado
  Cancelado
}
